<h1>Login</h1>

<%= form_with url: session_path do |form| %>

  <%= hidden_field_tag :join_token, session[:join_token] %>

  <div>
    <%= form.label :email %><br>
    <%= form.email_field :email %>
  </div>

  <br>

  <div>
    <%= form.label :password %><br>
    <%= form.password_field :password %>
  </div>

  <br>

  <div>
    <%= form.submit "Login" %>
  </div>

<% end %>

<br>

<%= link_to "Create a new account", new_user_path %>