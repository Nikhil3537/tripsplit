<div class="container app-shell py-4">
  <header class="app-toolbar d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between mb-4">
    <div>
      <p class="text-uppercase text-muted mb-1 small">TripSplit</p>
      <h1 class="display-6 fw-bold mb-0">Dashboard</h1>
      <p class="text-secondary mb-0">Your trips and expenses organized in one clean view.</p>
    </div>
    <div class="d-flex align-items-center gap-3 mt-3 mt-md-0">
      <div class="app-badge bg-primary text-white rounded-pill px-3 py-2 shadow-sm">
        <span class="small d-block text-uppercase opacity-75">Trips managed</span>
        <strong class="fs-5"><%= @total_trips %></strong>
      </div>
      <div class="app-avatar bg-white shadow-sm rounded-circle d-flex align-items-center justify-content-center">
        <span class="fw-bold text-primary"><%= @user.name[0].upcase %></span>
      </div>
    </div>
  </header>

  <section class="app-hero rounded-4 overflow-hidden mb-4 shadow-sm">
    <div class="row g-0">
      <div class="col-md-7 p-4 text-white app-hero-left">
        <p class="text-uppercase opacity-75 mb-2 small">Today</p>
        <h2 class="fw-bold mb-3">Stay on top of every trip.</h2>
        <p class="opacity-85 mb-4">View your latest balance summary, expense highlights, and recent activity in one beautiful app-like dashboard.</p>
        <div class="d-flex flex-wrap gap-2">
          <span class="badge rounded-pill bg-white text-primary px-3 py-2">Active trips: <strong><%= @active_trips %></strong></span>
          <span class="badge rounded-pill bg-white text-primary px-3 py-2">Completed: <strong><%= @completed_trips %></strong></span>
        </div>
      </div>
      <div class="col-md-5 p-4 bg-white">
        <div class="app-hero-card bg-gradient rounded-4 p-4 shadow-sm">
          <div class="d-flex align-items-center justify-content-between mb-3">
            <div>
              <p class="text-uppercase text-muted small mb-1">Balance overview</p>
              <h3 class="fw-bold mb-0">₹<%= @total_expenses %></h3>
            </div>
            <i class="bi bi-wallet2 fs-2 text-primary"></i>
          </div>
          <div class="d-flex gap-3">
            <div class="flex-fill bg-white rounded-4 p-3 text-center shadow-sm">
              <p class="text-uppercase text-muted small mb-1">You Owe</p>
              <strong class="text-danger fs-5">₹<%= @you_owe.round(2) %></strong>
            </div>
            <div class="flex-fill bg-white rounded-4 p-3 text-center shadow-sm">
              <p class="text-uppercase text-muted small mb-1">You Receive</p>
              <strong class="text-primary fs-5">₹<%= @you_receive.round(2) %></strong>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="row g-3 mb-4">
    <div class="col-12 col-md-6 col-lg-4">
      <div class="app-card rounded-4 shadow-sm p-4 h-100">
        <div class="d-flex align-items-center justify-content-between mb-3">
          <div>
            <p class="text-uppercase text-muted small mb-1">Total Trips</p>
            <h3 class="fw-bold mb-0"><%= @total_trips %></h3>
          </div>
          <span class="app-chip bg-blue text-white rounded-pill px-3 py-2"><i class="bi bi-airplane-fill"></i></span>
        </div>
        <p class="text-muted small mb-0">All trips you are part of in TripSplit.</p>
      </div>
    </div>
    <div class="col-12 col-md-6 col-lg-4">
      <div class="app-card rounded-4 shadow-sm p-4 h-100">
        <div class="d-flex align-items-center justify-content-between mb-3">
          <div>
            <p class="text-uppercase text-muted small mb-1">Members</p>
            <h3 class="fw-bold mb-0"><%= @total_members %></h3>
          </div>
          <span class="app-chip bg-purple text-white rounded-pill px-3 py-2"><i class="bi bi-people-fill"></i></span>
        </div>
        <p class="text-muted small mb-0">Participants across your active trips.</p>
      </div>
    </div>
    <div class="col-12 col-md-6 col-lg-4">
      <div class="app-card rounded-4 shadow-sm p-4 h-100">
        <div class="d-flex align-items-center justify-content-between mb-3">
          <div>
            <p class="text-uppercase text-muted small mb-1">Joined Trips</p>
            <h3 class="fw-bold mb-0"><%= @joined_trips %></h3>
          </div>
          <span class="app-chip bg-teal text-white rounded-pill px-3 py-2"><i class="bi bi-person-check-fill"></i></span>
        </div>
        <p class="text-muted small mb-0">Trips you joined and follow.</p>
      </div>
    </div>
  </section>

  <section class="row g-3 mb-4">
    <div class="col-12 col-lg-6">
      <div class="app-section rounded-4 shadow-sm overflow-hidden h-100">
        <div class="app-section-header bg-white p-4 border-bottom">
          <div class="d-flex align-items-center justify-content-between">
            <h5 class="mb-0">Settlement Analytics</h5>
            <span class="badge bg-info text-white">Updated</span>
          </div>
        </div>
        <div class="p-4 bg-light">
          <div class="row g-3">
            <div class="col-6">
              <div class="app-mini-card bg-white rounded-4 p-3 shadow-sm text-center">
                <p class="text-uppercase text-muted small mb-2">Pending</p>
                <h4 class="fw-bold mb-1"><%= @pending_count %></h4>
                  <p class="mb-0">₹<%= @pending_amount %></p>
              </div>
            </div>
            <div class="col-6">
              <div class="app-mini-card bg-white rounded-4 p-3 shadow-sm text-center">
                <p class="text-uppercase text-muted small mb-2">Completed</p>
                <h4 class="fw-bold mb-1"><%= @completed_count %></h4>
                  <p class="mb-0">₹<%= @completed_amount %></p>
              </div>
            </div>
          </div>
          <div class="row g-3 mt-3">
            <div class="col-6">
              <div class="app-mini-card bg-white rounded-4 p-3 shadow-sm text-center">
                <p class="text-uppercase text-muted small mb-2">Total amount</p>
                  <h4 class="fw-bold mb-0">₹<%= @total_settlement_amount %></h4>
              </div>
            </div>
            <div class="col-6">
              <div class="app-mini-card bg-white rounded-4 p-3 shadow-sm text-center">
                <p class="text-uppercase text-muted small mb-2">Completed</p>
                <h4 class="fw-bold mb-2"><%= @settlement_completion %>%</h4>
                <div class="progress app-progress mb-0">
                  <div class="progress-bar bg-info" role="progressbar" style="width: <%= @settlement_completion %>%" aria-valuenow="<%= @settlement_completion %>" aria-valuemin="0" aria-valuemax="100"></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-12 col-lg-6">
      <div class="app-section rounded-4 shadow-sm overflow-hidden h-100">
        <div class="app-section-header bg-white p-4 border-bottom">
          <div class="d-flex align-items-center justify-content-between">
            <h5 class="mb-0">Category Spending</h5>
            <span class="badge bg-success text-white">Top categories</span>
          </div>
        </div>
        <div class="p-4 bg-light">
          <table class="table app-table mb-0">
            <thead>
              <tr>
                <th>Category</th>
                <th>Total</th>
                <th>Share</th>
              </tr>
            </thead>
            <tbody>
              <% @category_expenses.each do |category, amount| %>
                <% percentage = @category_total.zero? ? 0 : ((amount / @category_total.to_f) * 100).round(1) %>
                <tr>
                  <td><%= category %></td>
                  <td class="fw-semibold">₹<%= amount %></td>
                  <td>
                    <div class="d-flex align-items-center gap-2">
                      <div class="progress flex-grow-1 app-progress mb-0">
                        <div class="progress-bar bg-primary" role="progressbar" style="width: <%= percentage %>%" aria-valuenow="<%= percentage %>" aria-valuemin="0" aria-valuemax="100"></div>
                      </div>
                      <span class="small text-muted"><%= percentage %>%</span>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <section class="row g-3 mb-4">
    <div class="col-12 col-lg-6">
      <div class="app-section rounded-4 shadow-sm overflow-hidden h-100">
        <div class="app-section-header bg-white p-4 border-bottom">
          <h5 class="mb-0">Recent Trips</h5>
        </div>
        <div class="list-group list-group-flush app-list-group">
          <% if @recent_trips.any? %>
            <% @recent_trips.each do |trip| %>
              <div class="list-group-item app-list-item d-flex align-items-center justify-content-between px-4 py-3">
                <div>
                  <strong><%= trip.name %></strong>
                  <div class="small text-muted"><%= trip.destination %></div>
                </div>
                <%= link_to "Open", trip_path(trip), class: "btn btn-sm btn-outline-primary" %>
              </div>
            <% end %>
          <% else %>
            <div class="p-4 text-center text-muted">No trips available.</div>
          <% end %>
        </div>
      </div>
    </div>

    <div class="col-12 col-lg-6">
      <div class="app-section rounded-4 shadow-sm overflow-hidden h-100">
        <div class="app-section-header bg-white p-4 border-bottom">
          <h5 class="mb-0">Recent Expenses</h5>
        </div>
        <div class="list-group list-group-flush app-list-group">
          <% if @recent_expenses.any? %>
            <% @recent_expenses.each do |expense| %>
              <div class="list-group-item app-list-item d-flex align-items-center justify-content-between px-4 py-3">
                <div>
                  <strong><%= expense.title %></strong>
                  <div class="small text-muted"><%= expense.trip.name %></div>
                </div>
                <span class="fw-semibold text-primary">₹<%= expense.amount %></span>
              </div>
            <% end %>
          <% else %>
            <div class="p-4 text-center text-muted">No expenses added.</div>
          <% end %>
        </div>
      </div>
    </div>
  </section>

  <section class="app-actions rounded-4 shadow-sm bg-white p-4 mb-4">
    <div class="d-flex align-items-center justify-content-between mb-3">
      <div>
        <h5 class="mb-1">Quick actions</h5>
        <p class="text-muted small mb-0">Launch the most common tasks instantly.</p>
      </div>
      <span class="badge bg-primary text-white">Fast</span>
    </div>
    <div class="row g-3">
      <div class="col-12 col-sm-6 col-xl-3">
        <%= link_to new_trip_path, class: "app-action-card rounded-4 d-block text-center p-4 text-decoration-none text-dark shadow-sm" do %>
          <i class="bi bi-plus-circle-fill fs-2 mb-2 text-primary"></i>
          <div class="fw-bold">New Trip</div>
        <% end %>
      </div>
      <% if @recent_trips.any? %>
        <div class="col-12 col-sm-6 col-xl-3">
          <%= link_to new_trip_expense_path(@recent_trips.first), class: "app-action-card rounded-4 d-block text-center p-4 text-decoration-none text-dark shadow-sm" do %>
            <i class="bi bi-wallet2 fs-2 mb-2 text-success"></i>
            <div class="fw-bold">Add Expense</div>
          <% end %>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
          <%= link_to trip_settlements_path(@recent_trips.first), class: "app-action-card rounded-4 d-block text-center p-4 text-decoration-none text-dark shadow-sm" do %>
            <i class="bi bi-receipt-cutoff fs-2 mb-2 text-warning"></i>
            <div class="fw-bold">Settlements</div>
          <% end %>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
          <%= link_to trips_path, class: "app-action-card rounded-4 d-block text-center p-4 text-decoration-none text-dark shadow-sm" do %>
            <i class="bi bi-grid-3x3-gap-fill fs-2 mb-2 text-secondary"></i>
            <div class="fw-bold">All Trips</div>
          <% end %>
        </div>
      <% else %>
        <div class="col-12 col-sm-6 col-xl-3">
          <%= link_to trips_path, class: "app-action-card rounded-4 d-block text-center p-4 text-decoration-none text-dark shadow-sm" do %>
            <i class="bi bi-grid-3x3-gap-fill fs-2 mb-2 text-secondary"></i>
            <div class="fw-bold">All Trips</div>
          <% end %>
        </div>
      <% end %>
    </div>
  </section>

</div>
