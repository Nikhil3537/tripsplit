<div class="d-flex justify-content-between align-items-center mb-4">

  <div>
    <h2 class="fw-bold">
      💰 Trip Expenses
    </h2>

    <p class="text-muted mb-0">
      Manage all expenses for this trip.
    </p>
  </div>

  <%= link_to "➕ Add Expense",
      new_trip_expense_path(@trip),
      class: "btn btn-primary" %>

</div>

<!-- Summary Cards -->

<div class="row mb-4">

  <div class="col-md-4">

    <div class="card dashboard-card bg-blue shadow">

      <div class="card-body text-center">

        <i class="bi bi-wallet2 fs-1"></i>

        <h5>Total Expenses</h5>

        <div class="stat-number">
          <%= @expenses.count %>
        </div>

      </div>

    </div>

  </div>

  <div class="col-md-4">

    <div class="card dashboard-card bg-green shadow">

      <div class="card-body text-center">

        <i class="bi bi-cash-stack fs-1"></i>

        <h5>Total Amount</h5>

        <div class="stat-number">

          ₹<%= @expenses.sum(:amount) %>

        </div>

      </div>

    </div>

  </div>

  <div class="col-md-4">

    <div class="card dashboard-card bg-orange shadow">

      <div class="card-body text-center">

        <i class="bi bi-people fs-1"></i>

        <h5>Members</h5>

        <div class="stat-number">

          <%= @trip.users.count %>

        </div>

      </div>

    </div>

  </div>

</div>

<!-- Expense Table -->

<div class="card shadow section-card">

  <div class="card-header bg-primary text-white">

    <h5 class="mb-0">

      <i class="bi bi-receipt"></i>

      Expense List

    </h5>

  </div>

  <div class="card-body">

    <% if @expenses.any? %>

      <table class="table table-hover align-middle">

        <thead>

          <tr>

            <th>Title</th>

            <th>Paid By</th>

            <th>Category</th>

            <th>Amount</th>

            <th>Date</th>

            <th width="220">Actions</th>

          </tr>

        </thead>

        <tbody>

          <% @expenses.each do |expense| %>

            <tr>

              <td>
                <strong><%= expense.title %></strong>
              </td>

              <td>
                <%= expense.payer.name %>
              </td>

              <td>

                <span class="badge bg-info">

                  <%= expense.category %>

                </span>

              </td>

              <td class="fw-bold text-success">

                ₹<%= expense.amount %>

              </td>

              <td>

                <%= expense.spent_on %>

              </td>

              <td>

                <%= link_to "View",
                    trip_expense_path(@trip, expense),
                    class: "btn btn-sm btn-primary" %>

                <%= link_to "Edit",
                    edit_trip_expense_path(@trip, expense),
                    class: "btn btn-sm btn-warning" %>

                <%= button_to "Delete",
                    trip_expense_path(@trip, expense),
                    method: :delete,
                    data: {
                      turbo_confirm: "Delete this expense?"
                    },
                    class: "btn btn-sm btn-danger d-inline" %>

              </td>

            </tr>

          <% end %>

        </tbody>

      </table>

    <% else %>

      <div class="text-center py-5">

        <i class="bi bi-wallet2 display-3 text-muted"></i>

        <h4 class="mt-3">

          No Expenses Found

        </h4>

        <p class="text-muted">

          Add your first expense to start tracking.

        </p>

      </div>

    <% end %>

  </div>

</div>

<div class="mt-4">

  <%= link_to "← Back to Trip",
      trip_path(@trip),
      class: "btn btn-secondary" %>

</div>